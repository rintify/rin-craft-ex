{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "put"
              },
              "object": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "vertices": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "number",
                        "minimum": -100000,
                        "maximum": 100000
                      },
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "minItems": 3,
                    "maxItems": 4000
                  },
                  "faces": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "minItems": 3,
                      "maxItems": 512
                    },
                    "minItems": 1,
                    "maxItems": 1200
                  },
                  "position": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": -100000,
                      "maximum": 100000
                    },
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "rotation": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": -100000,
                      "maximum": 100000
                    },
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "scale": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": 0.01,
                      "maximum": 1000
                    },
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "visible": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "name",
                  "vertices",
                  "faces",
                  "position",
                  "rotation",
                  "scale",
                  "visible"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "type",
              "object"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "remove"
              },
              "id": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "transform"
              },
              "id": {
                "type": "string"
              },
              "position": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": -100000,
                  "maximum": 100000
                },
                "minItems": 3,
                "maxItems": 3
              },
              "rotation": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": -100000,
                  "maximum": 100000
                },
                "minItems": 3,
                "maxItems": 3
              },
              "scale": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0.01,
                  "maximum": 1000
                },
                "minItems": 3,
                "maxItems": 3
              }
            },
            "required": [
              "type",
              "id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "settings"
              },
              "settings": {
                "type": "object",
                "properties": {
                  "paper": {
                    "enum": [
                      "A4",
                      "A3",
                      "Letter"
                    ]
                  },
                  "landscape": {
                    "type": "boolean"
                  },
                  "scale": {
                    "type": "number",
                    "minimum": 5,
                    "maximum": 500
                  },
                  "microEdgeLength": {
                    "type": "number",
                    "minimum": 0.01,
                    "maximum": 20
                  },
                  "margin": {
                    "type": "number",
                    "minimum": 5,
                    "maximum": 30
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "type",
              "settings"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "rename"
              },
              "name": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "type",
              "name"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "seams"
              },
              "seams": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "type",
              "seams"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "label",
    "operations"
  ],
  "additionalProperties": false
}